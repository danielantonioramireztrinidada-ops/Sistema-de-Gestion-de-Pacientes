
@page "/pacientes"
@using System.Net.Http.Json
@using SistemaPacientes.Client.Models
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Pacientes - SaludPlus</PageTitle>

<div class="patients-page">
    <div class="page-heading">
        <div>
            <h1>Pacientes</h1>
            <p>Consulta y administra los pacientes registrados.</p>
        </div>

        <button class="refresh-button" @onclick="MostrarFormulario">
            + Nuevo paciente
        </button>
    </div>

    @if (mostrarFormulario)
    {
        <div class="form-container">
            <h2>@(modoEdicion ? "Editar paciente" : "Registrar nuevo paciente")</h2>

            <EditForm Model="@nuevoPaciente" OnValidSubmit="GuardarPaciente">
                <DataAnnotationsValidator />

                <div class="form-grid">
                    <div>
                        <label>Nombres</label>
                        <InputText class="form-input" @bind-Value="nuevoPaciente.Nombres" />
                    </div>

                    <div>
                        <label>Apellidos</label>
                        <InputText class="form-input" @bind-Value="nuevoPaciente.Apellidos" />
                    </div>

                    <div>
                        <label>Cédula</label>
                        <InputText class="form-input" @bind-Value="nuevoPaciente.Cedula" />
                    </div>

                    <div>
                        <label>Teléfono</label>
                        <InputText class="form-input" @bind-Value="nuevoPaciente.Telefono" />
                    </div>

                    <div>
                        <label>Correo</label>
                        <InputText class="form-input" @bind-Value="nuevoPaciente.Correo" />
                    </div>

                    <div>
                        <label>Fecha de nacimiento</label>
                        <InputDate class="form-input" @bind-Value="nuevoPaciente.FechaNacimiento" />
                    </div>

                    <div>
                        <label>Dirección</label>
                        <InputText class="form-input" @bind-Value="nuevoPaciente.Direccion" />
                    </div>

                    <div>
                        <label>Sexo</label>
                        <InputSelect class="form-input" @bind-Value="nuevoPaciente.Sexo">
                            <option value="">Seleccione</option>
                            <option value="Masculino">Masculino</option>
                            <option value="Femenino">Femenino</option>
                        </InputSelect>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(mensaje))
                {
                    <p class="form-message">@mensaje</p>
                }

                <div class="form-actions">
                    <button type="button" class="cancel-button" @onclick="Cancelar">
                        Cancelar
                    </button>

                    <button type="submit" class="save-button" disabled="@guardando">
                        @(guardando ? "Guardando..." : modoEdicion ? "Actualizar paciente" : "Guardar paciente")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="summary-card">
        <div class="summary-icon">♙</div>
        <div>
            <span>Total de pacientes</span>
            <h2>@pacientes.Count</h2>
        </div>
    </div>

    @if (cargando)
    {
        <div class="message">Cargando pacientes...</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="error-message">@error</div>
    }
    else if (pacientes.Count == 0)
    {
        <div class="empty-message">
            <span>♙</span>
            <h3>No hay pacientes registrados</h3>
            <p>Cuando registres pacientes, aparecerán en esta tabla.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Paciente</th>
                        <th>Cédula</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th>Sexo</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var paciente in pacientes)
                    {
                        <tr>
                            <td>#@paciente.Id</td>
                            <td><strong>@paciente.Nombres @paciente.Apellidos</strong></td>
                            <td>@paciente.Cedula</td>
                            <td>@paciente.Telefono</td>
                            <td>@paciente.Correo</td>
                            <td>@paciente.Sexo</td>
                            <td>
                                <div class="action-buttons">
                                    <button class="edit-button"
                                            @onclick="() => EditarPaciente(paciente)">
                                        Editar
                                    </button>

                                    <button class="delete-button"
                                            @onclick="() => EliminarPaciente(paciente.Id)">
                                        Eliminar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<PacienteDto> pacientes = new();
    private CrearPacienteModel nuevoPaciente = new();

    private bool cargando = true;
    private bool mostrarFormulario;
    private bool guardando;
    private bool modoEdicion;

    private int pacienteIdEdicion;

    private string error = string.Empty;
    private string mensaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarPacientes();
    }

    private async Task CargarPacientes()
    {
        cargando = true;
        error = string.Empty;

        try
        {
            pacientes = await Http.GetFromJsonAsync<List<PacienteDto>>("api/Pacientes")
                        ?? new List<PacienteDto>();
        }
        catch
        {
            error = "No fue posible cargar los pacientes. Verifica que la API esté funcionando.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void MostrarFormulario()
    {
        nuevoPaciente = new CrearPacienteModel();
        modoEdicion = false;
        pacienteIdEdicion = 0;
        mensaje = string.Empty;
        mostrarFormulario = true;
    }

    private void EditarPaciente(PacienteDto paciente)
    {
        pacienteIdEdicion = paciente.Id;
        modoEdicion = true;

        nuevoPaciente = new CrearPacienteModel
        {
            Nombres = paciente.Nombres,
            Apellidos = paciente.Apellidos,
            Cedula = paciente.Cedula,
            Telefono = paciente.Telefono,
            Correo = paciente.Correo,
            FechaNacimiento = paciente.FechaNacimiento.Date,
            Direccion = paciente.Direccion,
            Sexo = paciente.Sexo
        };

        mensaje = string.Empty;
        mostrarFormulario = true;
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        modoEdicion = false;
        mensaje = string.Empty;
    }

    private async Task GuardarPaciente()
    {
        guardando = true;
        mensaje = string.Empty;

        try
        {
            HttpResponseMessage respuesta;

            if (modoEdicion)
            {
                respuesta = await Http.PutAsJsonAsync(
                    $"api/Pacientes/{pacienteIdEdicion}", nuevoPaciente);
            }
            else
            {
                respuesta = await Http.PostAsJsonAsync(
                    "api/Pacientes", nuevoPaciente);
            }

            if (respuesta.IsSuccessStatusCode)
            {
                mostrarFormulario = false;
                modoEdicion = false;
                nuevoPaciente = new CrearPacienteModel();
                await CargarPacientes();
            }
            else
            {
                mensaje = modoEdicion
                    ? "No se pudo actualizar el paciente."
                    : "No se pudo registrar el paciente. Verifica los datos.";
            }
        }
        catch
        {
            mensaje = "Error de conexión con la API.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarPaciente(int id)
    {
        bool confirmar = await JS.InvokeAsync<bool>(
            "confirm", "¿Estás seguro de que deseas eliminar este paciente?");

        if (!confirmar)
            return;

        try
        {
            var respuesta = await Http.DeleteAsync($"api/Pacientes/{id}");

            if (respuesta.IsSuccessStatusCode)
            {
                await CargarPacientes();
            }
            else
            {
                error = "No se pudo eliminar el paciente.";
            }
        }
        catch
        {
            error = "Error de conexión con la API.";
        }
    }

    public class CrearPacienteModel
    {
        public string Nombres { get; set; } = string.Empty;
        public string Apellidos { get; set; } = string.Empty;
        public string Cedula { get; set; } = string.Empty;
        public string Telefono { get; set; } = string.Empty;
        public string Correo { get; set; } = string.Empty;
        public DateTime FechaNacimiento { get; set; } = DateTime.Today;
        public string Direccion { get; set; } = string.Empty;
        public string Sexo { get; set; } = string.Empty;
    }
}

<style>
    .patients-page { max-width: 1200px; margin: auto; }
    .page-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
    .page-heading h1 { font-size: 26px; margin: 0 0 8px; }
    .page-heading p { color: #8996a7; font-size: 13px; }

    .refresh-button, .save-button {
        background: #16a085;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 11px 18px;
        cursor: pointer;
    }

    .summary-card {
        display: flex;
        align-items: center;
        gap: 16px;
        background: white;
        border: 1px solid #e8edf3;
        padding: 22px;
        border-radius: 12px;
        width: 260px;
        margin-bottom: 25px;
    }

    .summary-icon {
        background: #e8f1ff;
        color: #3976ce;
        padding: 14px;
        border-radius: 10px;
        font-size: 22px;
    }

    .summary-card span { color: #8996a7; font-size: 12px; }
    .summary-card h2 { margin: 5px 0 0; font-size: 25px; }

    .form-container, .table-container {
        background: white;
        border: 1px solid #e8edf3;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 25px;
    }

    .form-container h2 { font-size: 19px; margin-top: 0; margin-bottom: 20px; }
    .form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
    .form-grid label { display: block; font-size: 13px; margin-bottom: 7px; color: #526174; }

    .form-input {
        width: 100%;
        padding: 11px;
        border: 1px solid #dce3eb;
        border-radius: 7px;
        font-size: 13px;
        box-sizing: border-box;
    }

    .form-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 22px; }

    .cancel-button {
        background: #edf1f5;
        color: #526174;
        border: none;
        border-radius: 8px;
        padding: 11px 18px;
        cursor: pointer;
    }

    .save-button:disabled { opacity: .6; cursor: wait; }
    .form-message { color: #c0392b; font-size: 13px; }

    .table-container { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; text-align: left; }
    th { background: #f8fafc; color: #718096; font-size: 11px; padding: 17px; }
    td { padding: 17px; border-top: 1px solid #edf1f5; font-size: 12px; }

    .action-buttons { display: flex; gap: 7px; }

    .edit-button, .delete-button {
        border: none;
        border-radius: 6px;
        padding: 8px 11px;
        cursor: pointer;
        font-size: 12px;
    }

    .edit-button { background: #e8f1ff; color: #3976ce; }
    .delete-button { background: #fdecec; color: #c0392b; }

    .error-message, .empty-message, .message {
        background: white;
        padding: 35px;
        border-radius: 12px;
        text-align: center;
        color: #718096;
    }

    .error-message { color: #c0392b; }
    .empty-message span { font-size: 35px; color: #16a085; }
    .empty-message h3 { color: #1e293b; }

    @@media (max-width: 600px) {
        .page-heading { align-items: flex-start; gap: 12px; }
        .form-grid { grid-template-columns: 1fr; }
    }
</style>
