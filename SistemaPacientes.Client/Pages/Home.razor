
@page "/"

<PageTitle>Panel Principal - SaludPlus</PageTitle>

<div class="dashboard">
    <div class="welcome-section">
        <div>
            <h1>Panel principal</h1>
            <p>Bienvenido al Sistema de Gestión de Pacientes.</p>
        </div>
        <span class="welcome-icon">✚</span>
    </div>

    <div class="dashboard-cards">
        <div class="dashboard-card">
            <div class="card-icon patients-icon">♙</div>
            <div>
                <p>Total de pacientes</p>
                <h2>--</h2>
                <small>Pacientes registrados</small>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="card-icon doctors-icon">⚕</div>
            <div>
                <p>Total de médicos</p>
                <h2>--</h2>
                <small>Personal médico</small>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="card-icon appointments-icon">▣</div>
            <div>
                <p>Citas médicas</p>
                <h2>--</h2>
                <small>Gestión de citas</small>
            </div>
        </div>
    </div>

    <div class="dashboard-section">
        <h2>Accesos rápidos</h2>
        <p>Selecciona una opción para comenzar a trabajar.</p>

        <div class="quick-actions">
            <a href="/pacientes" class="quick-action">
                <span>♙</span>
                <div>
                    <strong>Gestionar pacientes</strong>
                    <small>Registrar, consultar y editar pacientes</small>
                </div>
            </a>

            <div class="quick-action disabled-action">
                <span>⚕</span>
                <div>
                    <strong>Médicos</strong>
                    <small>Próximamente</small>
                </div>
            </div>

            <div class="quick-action disabled-action">
                <span>▣</span>
                <div>
                    <strong>Citas médicas</strong>
                    <small>Próximamente</small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.dashboard {
    max-width: 1200px;
    margin: auto;
}

.welcome-section {
    background: white;
    padding: 30px;
    border-radius: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid #e8edf3;
}

.welcome-section h1 {
    font-size: 27px;
    margin: 0 0 10px;
}

.welcome-section p,
.dashboard-section > p {
    color: #8996a7;
    font-size: 13px;
}

.welcome-icon {
    background: #e6f8f3;
    color: #16b89a;
    border-radius: 15px;
    padding: 15px 20px;
    font-size: 30px;
}

.dashboard-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 25px;
}

.dashboard-card {
    background: white;
    border: 1px solid #e8edf3;
    border-radius: 13px;
    padding: 23px;
    display: flex;
    gap: 17px;
    align-items: center;
}

.card-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    font-size: 23px;
}

.patients-icon {
    background: #e8f1ff;
    color: #3976ce;
}

.doctors-icon {
    background: #e6f8f3;
    color: #16a085;
}

.appointments-icon {
    background: #fff2df;
    color: #d99128;
}

.dashboard-card p {
    color: #8996a7;
    font-size: 12px;
    margin: 0;
}

.dashboard-card h2 {
    margin: 5px 0;
    font-size: 25px;
}

.dashboard-card small {
    color: #a1adbb;
    font-size: 10px;
}

.dashboard-section {
    background: white;
    margin-top: 25px;
    padding: 28px;
    border: 1px solid #e8edf3;
    border-radius: 13px;
}

.dashboard-section h2 {
    font-size: 18px;
}

.quick-actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-top: 20px;
}

.quick-action {
    display: flex;
    gap: 13px;
    align-items: center;
    padding: 17px;
    border: 1px solid #e8edf3;
    border-radius: 10px;
    text-decoration: none;
    color: #1e293b;
}

.quick-action > span {
    color: #16a085;
    font-size: 25px;
}

.quick-action strong,
.quick-action small {
    display: block;
}

.quick-action strong {
    font-size: 12px;
}

.quick-action small {
    font-size: 10px;
    color: #8996a7;
    margin-top: 5px;
}

.quick-action:hover {
    border-color: #16b89a;
    background: #f8fffc;
}

.disabled-action {
    opacity: .55;
}

@@media (max-width: 800px) {
    .dashboard-cards,
    .quick-actions {
        grid-template-columns: 1fr;
    }
}
</style>
